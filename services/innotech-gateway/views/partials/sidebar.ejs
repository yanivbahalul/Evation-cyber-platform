<aside class="sidebar">
  <div class="section">
    <h4>Candidate Portal</h4>
    <nav class="nav" aria-label="Candidate navigation">
      <a class="<%= active === 'home' ? 'active' : '' %>" href="<%= withBase('/') %>"><span>Home</span><span>›</span></a>
      <% if (user) { %>
        <a class="<%= active === 'dashboard' ? 'active' : '' %>" href="<%= withBase('/workspace') %>"><span>Dashboard</span><span>›</span></a>
        <a class="<%= active === 'profile' ? 'active' : '' %>" href="<%= withBase('/profile') %>"><span>My Profile</span><span>›</span></a>
        <a class="<%= active === 'documents' ? 'active' : '' %>" href="<%= withBase('/documents') %>"><span>Documents</span><span>›</span></a>
        <a class="<%= active === 'contact' ? 'active' : '' %>" href="<%= withBase('/contact') %>"><span>Candidate Support</span><span>›</span></a>
      <% } else { %>
        <a class="<%= active === 'login' ? 'active' : '' %>" href="<%= withBase('/login') %>"><span>Candidate Sign In</span><span>→</span></a>
        <a class="<%= active === 'register' ? 'active' : '' %>" href="<%= withBase('/register') %>"><span>Create Account</span><span>→</span></a>
      <% } %>
    </nav>
  </div>

  <% if (user && user.role === 'admin' && canAccessOps === true) { %>
    <div class="section">
      <h4>Recruiting Team</h4>
      <nav class="nav">
        <a class="<%= active === 'hrTickets' ? 'active' : '' %>" href="<%= withBase('/hr-tickets') %>"><span>Support Requests</span><span>›</span></a>
      </nav>
    </div>
  <% } %>

  <% if (user) { %>
    <div class="section">
      <form action="<%= withBase('/logout') %>" method="POST" style="margin:0;">
        <button class="btn" type="submit" style="width:100%;">Sign out</button>
      </form>
    </div>
  <% } %>
</aside>
