<% const isLegacy = typeof brandTitle !== 'undefined'; %>
<header class="topbar">
  <a class="brand" href="<%= withBase('/') %>" aria-label="InnoTech Careers home">
    <span class="brand-badge" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 10H15V30H9V10Z" fill="white"/>
        <path d="M17 9H32V14H27.5V30H21.5V14H17V9Z" fill="white"/>
        <path d="M29 8L33 12L29 16" stroke="#A9C5FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span>
      <span><%= typeof brandTitle !== 'undefined' ? brandTitle : 'InnoTech' %></span>
      <span class="brand-sub"><%= typeof brandSub !== 'undefined' ? brandSub : 'Careers' %></span>
    </span>
  </a>

  <nav class="top-actions" aria-label="Primary navigation">
    <% if (isLegacy) { %>
      <span class="account-label"><strong><%= typeof accessLabel !== 'undefined' ? accessLabel : (user ? user.username : 'Restricted') %></strong><% if (typeof accessDetail !== 'undefined') { %> · <%= accessDetail %><% } %></span>
      <% if (user && typeof showSignOut !== 'undefined' && showSignOut) { %>
        <% const out = (typeof dp !== 'undefined' && dp.signOut) ? dp.signOut : '/internal/auth/signout'; %>
        <form method="POST" action="<%= withBase(out) %>" style="margin:0;"><button type="submit" class="top-link primary" style="border:0;">Sign out</button></form>
      <% } %>
    <% } else if (user) { %>
      <span class="account-label">Welcome, <strong><%= user.username %></strong></span>
      <a class="top-link" href="<%= withBase('/workspace') %>">Dashboard</a>
      <a class="top-link" href="<%= withBase('/contact') %>">Support</a>
      <% if (user.role === 'admin' && typeof canAccessOps !== 'undefined' && canAccessOps === true) { %>
        <a class="top-link primary" href="<%= withBase('/dashboard/') %>">HoneyShield</a>
      <% } %>
      <form action="<%= withBase('/logout') %>" method="POST" style="margin:0;">
        <button class="top-link primary" type="submit" style="border:0;">Sign out</button>
      </form>
    <% } else { %>
      <a class="top-link" href="<%= withBase('/contact') %>">Candidate Support</a>
      <a class="top-link" href="<%= withBase('/login') %>">Sign In</a>
      <a class="top-link primary" href="<%= withBase('/register') %>">Create Account</a>
    <% } %>
  </nav>
</header>
