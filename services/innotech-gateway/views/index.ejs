<% const user = typeof locals !== 'undefined' ? (locals.user || null) : (typeof user !== 'undefined' ? user : null); %>
<% const adminPanelUrl = typeof locals !== 'undefined' ? (locals.adminPanelUrl || '') : (typeof adminPanelUrl !== 'undefined' ? adminPanelUrl : ''); %>
<% const title = 'InnoTech People — Recruitment Safe Zone' %>
<%- include('partials/head', { title }) %>

<div class="container">
  <%- include('partials/topbar', { user }) %>

  <div class="layout">
    <%- include('partials/sidebar', { user, active: 'home', adminPanelUrl }) %>

    <main class="card">
      <div class="hero">
        <div class="kicker">Recruitment & people operations</div>
        <h2 style="margin: 0 0 8px;">A safe place to start and grow your career</h2>
        <div class="muted" style="max-width: 60ch;">
          Apply, complete onboarding, and access employee services from one protected workspace. Your personal information
          stays separate from the security operations that protect this environment.
        </div>
      </div>

      <div class="card-inner">
        <div class="grid-3">
          <div class="stat">
            <div class="label">Candidate privacy</div>
            <div class="value">Protected</div>
            <div class="muted2" style="margin-top: 6px;">Secure account and MFA support</div>
          </div>
          <div class="stat">
            <div class="label">Application process</div>
            <div class="value">One place</div>
            <div class="muted2" style="margin-top: 6px;">Profile, tasks, and documents</div>
          </div>
          <div class="stat">
            <div class="label">People support</div>
            <div class="value">Available</div>
            <div class="muted2" style="margin-top: 6px;">Help throughout your journey</div>
          </div>
        </div>

        <div style="height: 14px;"></div>

        <% if (user) { %>
          <div class="btn-row">
            <a class="btn primary" href="<%= withBase('/workspace') %>">Open my workspace</a>
            <a class="btn" href="<%= withBase('/documents') %>">Browse documents</a>
            <a class="btn" href="<%= withBase('/profile') %>">My profile</a>
          </div>
        <% } else { %>
          <div class="btn-row">
            <a class="btn primary" href="<%= withBase('/register') %>">Create candidate profile</a>
            <a class="btn" href="<%= withBase('/login') %>">Sign in</a>
            <a class="btn" href="<%= withBase('/contact') %>">Contact support</a>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<%- include('partials/foot') %>
