<% const title = 'Candidate Profile — InnoTech Careers' %>
<%- include('partials/head', { title }) %>

<div class="container">
  <%- include('partials/topbar', { user }) %>

  <div class="layout">
    <%- include('partials/sidebar', { user, active: 'profile', adminPanelUrl }) %>

    <main class="card">
      <div class="hero hero-profile">
        <div class="kicker">Your details</div>
        <h2>Candidate Profile</h2>
        <div class="muted">Review the information associated with your candidate account.</div>
      </div>

      <div class="card-inner">
        <table class="table">
          <thead>
            <tr><th>Field</th><th>Value</th></tr>
          </thead>
          <tbody>
            <% profileRows.forEach(r => { %>
              <tr>
                <td><%= r.label %></td>
                <td><%= r.value %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div style="height: 12px;"></div>

        <div class="btn-row">
          <button class="btn" type="button" id="edit-profile-btn">Edit details</button>
          <a class="btn primary" href="<%= withBase('/workspace') %>">Back to dashboard</a>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  (function () {
    var btn = document.getElementById('edit-profile-btn');
    if (!btn) return;
    var ticketUrl = '<%= withBase('/contact') %>?subject=' + encodeURIComponent('Profile update request') + '&source=profile_edit';
    btn.addEventListener('click', function () {
      alert('Profile changes are reviewed by the recruiting team. Please send a support request.');
      window.location.href = ticketUrl;
    });
  })();
</script>

<%- include('partials/foot') %>
