<% const title = 'Create Candidate Account — InnoTech Careers' %>
<%- include('partials/head', { title }) %>
<% const error = typeof locals !== 'undefined' ? (locals.error || '') : (typeof error !== 'undefined' ? error : ''); %>
<% const username = typeof locals !== 'undefined' ? (locals.username || '') : (typeof username !== 'undefined' ? username : ''); %>
<div class="container">
  <%- include('partials/topbar', { user: null }) %>
  <main class="layout auth-layout">
    <div class="auth-wrap">
      <section class="auth-aside"><div class="kicker">Candidate profile</div><h1>Keep your application journey in one place.</h1><p>Create an account to manage requested tasks, profile information, documents, and updates.</p></section>
      <section class="auth-panel">
        <h2>Create your candidate account</h2>
        <p class="muted">Choose your sign-in details. Account verification follows next.</p>
        <% if (error) { %><div class="alert" role="alert"><strong>Account not created.</strong> <%= error %></div><% } %>
        <form class="form" action="<%= withBase('/register') %>" method="POST" style="margin-top:16px;">
          <label>Username<input class="input" type="text" name="username" autocomplete="username" required value="<%= username %>" placeholder="Choose a username" /></label>
          <label>Password<input class="input" type="password" name="password" autocomplete="new-password" required placeholder="At least 8 characters" /></label>
          <button class="btn primary" type="submit" style="width:100%;">Create account</button>
        </form>
        <p class="muted2" style="margin:18px 0 0;font-size:13px;">Already have an account? <a href="<%= withBase('/login') %>" style="color:var(--primary);font-weight:650;">Sign in</a></p>
      </section>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
