<% const title = 'Set Up Account Verification — InnoTech Careers' %>
<%- include('partials/head', { title }) %>
<% const error = typeof locals !== 'undefined' ? (locals.error || '') : (typeof error !== 'undefined' ? error : ''); %>
<div class="container">
  <%- include('partials/topbar', { user: null }) %>
  <main class="layout auth-layout">
    <div class="auth-wrap">
      <section class="auth-aside"><div class="kicker">Account setup</div><h1>Secure your candidate account.</h1><p>Scan the QR code with your authenticator app, then enter the 6-digit verification code.</p></section>
      <section class="auth-panel">
        <h2>Set up account verification</h2>
        <p class="muted">Account: <strong><%= username %></strong></p>
        <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
        <div class="qr-card"><img src="<%= qrDataUrl %>" alt="Authenticator QR code" style="width:190px;height:190px;display:block;" /></div>
        <details><summary class="muted2" style="cursor:pointer;font-size:13px;">Can’t scan? Use manual entry</summary><div class="code-block"><%= otpauth %></div></details>
        <form class="form" action="<%= withBase('/register/verify-otp') %>" method="POST" style="margin-top:18px;">
          <label>Verification code<input class="input" name="otp" placeholder="123456" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required /></label>
          <button class="btn primary" type="submit" style="width:100%;">Verify and continue</button>
        </form>
      </section>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
