<% const title = 'Candidate Support — InnoTech Careers' %>
<%- include('partials/head', { title }) %>
<div class="container">
  <%- include('partials/topbar', { user }) %>
  <div class="layout">
    <%- include('partials/sidebar', { user, active: 'contact', adminPanelUrl }) %>
    <main class="card">
      <div class="hero support-hero"><div class="kicker">Candidate Support</div><h2>How can we help?</h2><div class="muted">Send a message to our recruiting support team.</div></div>
      <div class="card-inner" style="max-width:760px;">
        <% if (success) { %><div class="alert success" role="status">Request #<%= ticketId %> has been received. Keep this number for reference.</div><% } %>
        <% if (formError) { %><div class="alert" role="alert"><%= formError %></div><% } %>
        <% if (!success) { %>
          <form class="form" method="POST" action="<%= withBase('/contact') %>">
            <input type="hidden" name="source" value="<%= typeof source !== 'undefined' ? source : 'contact' %>" />
            <label>Subject<input class="input" name="subject" placeholder="What can we help with?" value="<%= typeof subject !== 'undefined' ? subject : '' %>" required /></label>
            <label>Message<textarea class="input" name="message" rows="6" placeholder="Share the details of your request" required><%= typeof message !== 'undefined' ? message : '' %></textarea></label>
            <button class="btn primary" type="submit">Send request</button>
          </form>
        <% } else { %><a class="btn primary" href="<%= withBase('/workspace') %>">Back to dashboard</a><% } %>
      </div>
    </main>
  </div>
</div>
<%- include('partials/foot') %>
