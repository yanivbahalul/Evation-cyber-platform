<% const title = 'Candidate Sign In — InnoTech Careers' %>
<%- include('partials/head', { title }) %>
<% const error = typeof locals !== 'undefined' ? (locals.error || '') : (typeof error !== 'undefined' ? error : ''); %>
<% const username = typeof locals !== 'undefined' ? (locals.username || '') : (typeof username !== 'undefined' ? username : ''); %>
<div class="container">
  <%- include('partials/topbar', { user: null }) %>
  <main class="layout auth-layout">
    <div class="auth-wrap">
      <section class="auth-aside"><div class="auth-brand-logo" aria-hidden="true"></div><div class="kicker">InnoTech Careers</div><h1>Your next step starts here.</h1><p>Access your candidate profile, application tasks, updates, and documents.</p></section>
      <section class="auth-panel">
        <h2>Candidate Sign In</h2>
        <p class="muted">Welcome back. Sign in to continue to your candidate account.</p>
        <% if (error) { %><div class="alert" role="alert"><strong>Sign in failed.</strong> <%= error %></div><% } %>
        <form class="form" action="<%= withBase('/login') %>" method="POST" style="margin-top:16px;">
          <label>Username<input class="input" type="text" name="username" autocomplete="username" required value="<%= username %>" placeholder="Enter your username" /></label>
          <label>Password<input class="input" type="password" name="password" autocomplete="current-password" required placeholder="Enter your password" /></label>
          <button class="btn primary" type="submit" style="width:100%;">Continue</button>
        </form>
        <p class="muted2" style="margin:18px 0 0;font-size:13px;">New to InnoTech? <a href="<%= withBase('/register') %>" style="color:var(--primary);font-weight:650;">Create your candidate profile</a></p>
      </section>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
