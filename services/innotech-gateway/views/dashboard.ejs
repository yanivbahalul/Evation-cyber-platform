<% const title = 'Candidate Dashboard — InnoTech Careers' %>
<%- include('partials/head', { title }) %>
<div class="container">
  <%- include('partials/topbar', { user }) %>
  <div class="layout">
    <%- include('partials/sidebar', { user, active: 'dashboard', adminPanelUrl }) %>
    <main class="card">
      <div class="hero"><div class="kicker">Candidate Dashboard</div><h2>Welcome back, <%= user.username %></h2><div class="muted">Review your application tasks, updates, and candidate resources.</div></div>
      <div class="card-inner">
        <div class="grid-3">
          <div class="stat"><div class="label">Application tasks</div><div class="value"><%= tasks.length %></div><div class="muted2" style="margin-top:6px;">Available tasks</div></div>
          <div class="stat"><div class="label">Updates</div><div class="value"><%= announcements.length %></div><div class="muted2" style="margin-top:6px;">Current messages</div></div>
          <div class="stat"><div class="label">Documents</div><div class="value"><%= documents.length %></div><div class="muted2" style="margin-top:6px;">Available resources</div></div>
        </div>
        <div class="content-grid">
          <section class="panel">
            <h3>Application Tasks</h3>
            <div class="table-scroll"><table class="table"><thead><tr><th>Task</th><th>Status</th></tr></thead><tbody>
              <% if (!tasks.length) { %><tr><td colspan="2" class="muted2">No application tasks are available.</td></tr><% } %>
              <% tasks.forEach(t => { %><tr><td><%= t.title %></td><td><span class="badge <%= t.status === 'Done' ? 'ok' : (t.status === 'Pending' ? 'warn' : '') %>"><%= t.status %></span></td></tr><% }) %>
            </tbody></table></div>
          </section>
          <div class="stack">
            <section class="panel"><h3>Updates</h3><% if (!announcements.length) { %><p class="muted2">No updates right now.</p><% } %><% announcements.forEach(a => { %><div class="notice"><strong><%= a.title %></strong><div class="muted2" style="margin-top:4px;font-size:13px;"><%= a.body %></div></div><% }) %></section>
            <section class="panel"><h3>Quick links</h3><div class="btn-row"><a class="btn primary" href="<%= withBase('/documents') %>">View documents</a><a class="btn" href="<%= withBase('/contact') %>?source=dashboard">Candidate support</a></div></section>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('partials/foot') %>
