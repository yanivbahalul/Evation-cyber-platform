<% const title = 'Candidate Account — InnoTech Careers' %>
<%- include('partials/head', { title }) %>

<div class="container">
  <%- include('partials/topbar', { user }) %>

  <div class="layout">
    <%- include('partials/sidebar', { user, active: 'dashboard', adminPanelUrl }) %>

    <main class="card">
      <div class="hero">
        <div class="kicker">Candidate account</div>
        <h2>Welcome, <%= user.username %></h2>
        <div class="muted">Your profile is ready. Continue to your candidate dashboard.</div>
      </div>
      <div class="card-inner">
        <div class="btn-row">
          <a class="btn primary" href="<%= withBase('/workspace') %>">Open candidate dashboard</a>
          <a class="btn" href="<%= withBase('/documents') %>">Documents</a>
          <a class="btn" href="<%= withBase('/profile') %>">My profile</a>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('partials/foot') %>
