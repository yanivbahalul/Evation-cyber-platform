<% const title = 'Verify Your Account — InnoTech Careers' %>
<%- include('partials/head', { title }) %>
<% const error = typeof locals !== 'undefined' ? (locals.error || '') : (typeof error !== 'undefined' ? error : ''); %>
<div class="container">
  <%- include('partials/topbar', { user: null }) %>
  <main class="layout auth-layout">
    <div class="auth-wrap">
      <section class="auth-aside"><div class="kicker">Account verification</div><h1>One quick step to continue.</h1><p>Use the verification code from your authenticator app to access your candidate account.</p></section>
      <section class="auth-panel">
        <h2>Verify your account</h2>
        <p class="muted">Enter the 6-digit code for <strong><%= username %></strong>.</p>
        <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
        <form class="form" action="<%= withBase('/login/verify-otp') %>?next=<%= encodeURIComponent(next || '/me') %>" method="POST" style="margin-top:16px;">
          <label>Verification code<input class="input" name="otp" placeholder="123456" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required /></label>
          <button class="btn primary" type="submit" style="width:100%;">Verify and sign in</button>
        </form>
        <a href="<%= withBase('/login') %>" class="muted2" style="margin-top:18px;font-size:13px;">Back to sign in</a>
      </section>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
