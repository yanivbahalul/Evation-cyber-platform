<% const title = 'InnoTech — API Integration Keys' %>
<% const wb = typeof withBase === 'function' ? withBase : (p) => p %>
<% const exportPath = (typeof dp !== 'undefined' && dp.hrExport) ? dp.hrExport : '/internal/api/v1/hr/export' %>
<%- include('../partials/head', { title, withBase: wb }) %>

<div class="container">
  <%- include('../partials/topbar', {
    user: typeof legacyUser !== 'undefined' ? legacyUser : null,
    withBase: wb,
    brandTitle: 'InnoTech Administrator Services',
    brandSub: 'Legacy control plane',
    accessLabel: 'Operator',
    accessDetail: 'integrations'
  }) %>

  <div class="layout">
    <%- include('../partials/decoy-sidebar', { active: 'api', withBase: wb, legacyUser: typeof legacyUser !== 'undefined' ? legacyUser : null }) %>

    <main class="card">
      <div class="hero">
        <div class="kicker">Integrations</div>
        <h2 style="margin: 0 0 8px;">Service API key</h2>
        <div class="muted">Use in scripts or <code style="color:var(--primary)">Authorization: Bearer</code> headers.</div>
      </div>

      <div class="card-inner">
        <div class="badge warn" style="margin-bottom: 12px;">Confidential — do not commit to source control</div>

        <div class="stat" style="margin-bottom: 14px;">
          <div class="label">Active key</div>
          <div class="value" style="font-size: 14px; font-family: ui-monospace, monospace; word-break: break-all;"><%= apiKey %></div>
        </div>

        <div class="muted2" style="font-size: 13px; line-height: 1.6; margin-bottom: 14px;">
          Service account: <strong style="color: var(--text);"><%= user.email || user %></strong><br />
          Export HR records via the internal API (automation / curl).
        </div>

        <div class="stat" style="margin-bottom: 14px;">
          <div class="label">HR export endpoint</div>
          <div class="value" style="font-size: 13px; font-family: ui-monospace, monospace; word-break: break-all;">
            GET <%= wb(exportPath) %>
          </div>
        </div>

        <pre class="input" style="font-size: 12px; line-height: 1.5; white-space: pre-wrap; margin: 0 0 14px;">curl -s \
  -H "Authorization: Bearer <%= apiKey %>" \
  "<%= wb(exportPath) %>" | jq .</pre>

        <div class="muted2" style="font-size: 12px; line-height: 1.5;">
          Any request with this key is logged. The export returns JSON employee credentials from the read replica.
        </div>

        <div class="btn-row" style="margin-top: 16px;">
          <a class="btn" href="<%= wb((typeof dp !== 'undefined' && dp.console) || '/internal/console') %>">Administrator console</a>
          <a class="btn" href="<%= wb('/') %>">Public portal</a>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/foot') %>
