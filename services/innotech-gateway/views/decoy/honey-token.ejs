<% const title = 'InnoTech — API Integrations' %>
<% const wb = typeof withBase === 'function' ? withBase : (p) => p %>
<% const items = Array.isArray(integrations) ? integrations : [] %>
<%- include('../partials/head', { title, withBase: wb }) %>

<div class="container">
  <%- include('../partials/topbar', {
    user: typeof legacyUser !== 'undefined' ? legacyUser : null,
    withBase: wb,
    brandTitle: 'InnoTech Administrator Services',
    brandSub: 'Legacy control plane',
    accessLabel: 'Operator',
    accessDetail: 'integrations'
  }) %>

  <div class="layout">
    <%- include('../partials/decoy-sidebar', { active: 'api', withBase: wb, legacyUser: typeof legacyUser !== 'undefined' ? legacyUser : null }) %>

    <main class="card">
      <div class="hero">
        <div class="kicker">Integrations</div>
        <h2 style="margin: 0 0 8px;">Service API integrations</h2>
        <div class="muted">Credentials are provisioned by the deploy pipeline (Vault) and rotated automatically.</div>
      </div>

      <div class="card-inner">
        <div class="badge warn" style="margin-bottom: 12px;">Keys are masked — full values are managed in CI/CD secrets, not shown here.</div>

        <table class="table">
          <thead>
            <tr>
              <th>Service</th>
              <th>Owner</th>
              <th>Type</th>
              <th>Scopes</th>
              <th>Key</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(it => { %>
            <tr>
              <td><strong><%= it.service %></strong></td>
              <td class="muted2"><%= it.owner %></td>
              <td><span class="badge"><%= it.tokenType %></span></td>
              <td class="muted2" style="font-size:12px;"><%= (it.scopes || []).join(', ') %></td>
              <td><code style="font-size:12px;"><%= it.maskedKey %></code></td>
              <td><span class="badge ok"><%= it.status %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="muted2" style="font-size: 12px; line-height: 1.6; margin-top: 14px;">
          To rotate a key, trigger the <code>rotate-secrets</code> pipeline. Every request made with a
          service key is logged against the owning account.
        </div>

        <div class="btn-row" style="margin-top: 16px;">
          <a class="btn" href="<%= wb((typeof dp !== 'undefined' && dp.console) || '/internal/console') %>">Administrator console</a>
          <a class="btn" href="<%= wb('/') %>">Public portal</a>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/foot') %>
